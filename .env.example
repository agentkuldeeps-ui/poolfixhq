# Copy to .env.local for local development, and set both in Vercel.

# Canonical origin. Drives canonical tags, sitemap, RSS and llms.txt.
NEXT_PUBLIC_SITE_URL=https://poolfixhq.com

# Amazon Associates tracking tag, e.g. poolfixhq-20
#
# The fallback in lib/site.js is a deliberately invalid placeholder, and
# scripts/check-compliance.mjs fails the build if it reaches a rendered link.
# An untagged affiliate link earns nothing, so this must be set before any
# review goes live.
NEXT_PUBLIC_AMAZON_TAG=
